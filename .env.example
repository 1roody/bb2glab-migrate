# Copie para .env e preencha (cp .env.example .env). O .env NÃO deve ser commitado.

# Bitbucket Cloud: E-MAIL da conta Atlassian (exigido pelo importador do GitLab e pela API)
BITBUCKET_USER=
# API token do Bitbucket Cloud com escopos read:repository:bitbucket e read:pullrequest:bitbucket.
# É enviado ao GitLab na chamada de importação (POST /import/bitbucket). App Passwords não são suportados.
BITBUCKET_TOKEN=
# (Opcional) usuário usado só no git clone/ls-remote. Com API token o Bitbucket recusa o e-mail no git;
# o padrão x-bitbucket-api-token-auth funciona. Deixe vazio, salvo se precisar trocar.
BITBUCKET_GIT_USER=

# GitLab (opcional): personal access token com escopo api. Se definido, o bb2gl usa a API e o Git
# do GitLab direto, sem o glab. Vazio: usa o glab (glab auth login). Detalhes em docs/configuracao.md.
GITLAB_TOKEN=

# GitLab: grupo/subgrupo base de destino, formato grupo/subgrupo (sem barra inicial). O grupo precisa
# existir; projetos ausentes são criados pelo importador (ou vazios, se a importação falhar).
# Ex.: meu-grupo/meu-subgrupo  ->  gitlab.com/meu-grupo/meu-subgrupo/<repo>
# Se ficar vazio, o bb2gl pergunta ao rodar. Uma linha do repos.txt com destino explícito ignora esta base.
GITLAB_DEST_PATH=
